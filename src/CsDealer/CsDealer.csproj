<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 covers .NET Framework 4.6.1+, Unity, Xamarin and Mono; net8.0 gets the faster code paths. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>CsDealer</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>CsDealer</PackageId>
    <Version>2.0.0</Version>
    <Authors>Aaron Liftig</Authors>
    <Description>A playing card library for .NET: cards, stacks, decks, configurable ranking and built-in SVG card art. A C# port of PyDealer.</Description>
    <PackageTags>cards;playing-cards;deck;poker;card-game;svg</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AaronLiftig/CsDealer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="CsDealer.Tests" />
  </ItemGroup>

</Project>
